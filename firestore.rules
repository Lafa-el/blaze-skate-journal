rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    match /athletes/{docId} {
      // getAthleteProfile reads athletes/{uid}. The id and athleteId must both be this user.
      allow get: if signedIn()
        && request.auth.uid == docId
        && resource.data.athleteId == docId;
      // getLegacyAthleteProfilesByAthleteId queries where athleteId == uid and does not
      // constrain the document id. A docId check here would reject that query for the owner.
      allow list: if signedIn()
        && resource.data.athleteId == request.auth.uid;
    }

    match /journal_days/{docId} {
      allow get, list: if signedIn() && resource.data.athleteId == request.auth.uid;
    }

    match /training_sessions/{docId} {
      allow get, list: if signedIn() && resource.data.athleteId == request.auth.uid;
    }

    match /coach_notes/{docId} {
      allow get, list: if signedIn() && resource.data.athleteId == request.auth.uid;
    }

    match /body_status/{docId} {
      allow get, list: if signedIn() && resource.data.athleteId == request.auth.uid;
    }

    match /performance_records/{docId} {
      allow get, list: if signedIn() && resource.data.athleteId == request.auth.uid;
    }

    match /video_refs/{docId} {
      allow get, list: if signedIn() && resource.data.athleteId == request.auth.uid;
    }

    match /weekly_reviews/{docId} {
      allow get, list: if signedIn() && resource.data.athleteId == request.auth.uid;
    }

    match /milestones/{docId} {
      allow get, list: if signedIn() && resource.data.athleteId == request.auth.uid;
    }
  }
}
